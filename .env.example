# Postgres (ex.: Neon). DATABASE_URL = conexão "pooled"; DIRECT_URL = conexão direta.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler/BANCO?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require"
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Em produção (Vercel) o domínio do projeto é aceito automaticamente.
