{
  "name": "achedoacoes",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs && npm run db:migrate && npm run db:seed",
    "dev": "node scripts/dev.mjs",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm test -w backend",
    "start": "npm start -w backend"
  },
  "dependencies": {
    "@prisma/client": "6.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "prisma": "6.3.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
