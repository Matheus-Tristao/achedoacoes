{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "db:migrate": "prisma db push && prisma db execute --file prisma/integrity.sql --schema prisma/schema.prisma && prisma generate",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.3.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "node-mocks-http": "^1.18.1",
    "prisma": "6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
